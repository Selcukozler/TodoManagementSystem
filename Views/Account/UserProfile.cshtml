@model TodoManagementSystem.Models.ApplicationUser
@{
    ViewData["Title"] = "Kullanıcı Profili ve Görevleri";
    Layout = "_UserLayout"; 
    
    // ViewBag içinden gelen görevleri sayfada kullanılabilir listeye çeviriyoruz
    var userTodos = ViewBag.UserTodos as IEnumerable<TodoManagementSystem.Models.TodoItem>; 
}

<div class="row mt-4">
    <!-- Profil Bilgileri Kartı (Sol Kolon) -->
    <div class="col-md-4 mb-4">
        <div class="card">
            <div class="card-body text-center">
                <!-- Eğer kullanıcının fotoğrafı varsa onu, yoksa varsayılanı gösteriyoruz -->
                @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                {
                    <img src="@Model.ProfilePicturePath" alt="User Avatar" class="rounded-circle mb-3" width="100" height="100" style="object-fit:cover;">
                }
                else
                {
                    <img src="~/sneat/assets/img/avatars/1.png" alt="User Avatar" class="rounded-circle mb-3" width="100">
                }
                
                <h4>@(string.IsNullOrEmpty(Model.FirstName) ? Model.UserName : $"{Model.FirstName} {Model.LastName}")</h4> 
                <p class="text-muted">@Model.Email</p>
                
                @if(!string.IsNullOrEmpty(Model.Bio))
                {
                    <p class="text-sm mt-3 mb-0">@Model.Bio</p>
                }
            </div>
        </div>
    </div>

    <!-- Kullanıcının Görevleri (Sağ Kolon) -->
    <div class="col-md-8">
        <div class="card mb-4">
            <h5 class="card-header d-flex justify-content-between align-items-center">
                Kullanıcının Görevleri 
                <span class="badge bg-primary rounded-pill">@(userTodos?.Count() ?? 0)</span>
            </h5>
            
            <div class="card-body">
                @if (userTodos != null && userTodos.Any())
                {
                    <div class="list-group">
                        @foreach (var todo in userTodos)
                        {
                            <a asp-controller="Todo" asp-action="Details" asp-route-id="@todo.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-1 @(todo.IsCompleted ? "text-decoration-line-through text-muted" : "")">@todo.Title</h6>
                                    <small class="text-muted">Oluşturulma: @todo.CreatedAt.ToString("dd.MM.yyyy")</small>
                                </div>
                                
                                @if(todo.IsCompleted) 
                                { 
                                    <span class="badge bg-label-success">Tamamlandı</span> 
                                }
                                else 
                                { 
                                    <span class="badge bg-label-warning text-dark">Devam Ediyor</span> 
                                }
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary mb-0" role="alert">
                        <i class="bx bx-info-circle me-1"></i> Bu kullanıcının henüz bir görevi bulunmuyor.
                    </div>
                }
            </div>
        </div>
    </div>
</div>