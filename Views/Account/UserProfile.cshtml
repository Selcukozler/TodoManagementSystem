@model TodoManagementSystem.Models.ApplicationUser
@{ 
    ViewData["Title"] = Model.UserName + " Profili";
    var userTodos = ViewBag.UserTodos as List<TodoManagementSystem.Models.TodoItem>;
}

<div class="row mt-4">
    <!-- Kullanıcı Kartı -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm text-center">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                {
                    <img src="@Model.ProfilePicturePath" class="rounded-circle img-thumbnail mb-3" style="width: 120px; height: 120px; object-fit: cover;" />
                }
                else
                {
                    <img src="https://cdn-icons-png.flaticon.com/512/149/149071.png" class="rounded-circle img-thumbnail mb-3" style="width: 120px; height: 120px; object-fit: cover;" />
                }
                
                <h4 class="card-title">@(string.IsNullOrEmpty(Model.FirstName) ? Model.UserName : $"{Model.FirstName} {Model.LastName}")</h4>
                <p class="text-muted">@Model.Email</p>
                <p class="mt-3"><i>@(string.IsNullOrEmpty(Model.Bio) ? "Bu kullanıcı henüz bir biyografi eklememiş." : Model.Bio)</i></p>
            </div>
        </div>
    </div>

    <!-- Kullanıcının Görevleri -->
    <div class="col-md-8">
        <h4 class="mb-3">Kullanıcının Görevleri (@userTodos?.Count)</h4>
        
        @if (userTodos != null && userTodos.Any())
        {
            <div class="list-group shadow-sm">
                @foreach (var todo in userTodos)
                {
                    <a asp-controller="Todo" asp-action="Details" asp-route-id="@todo.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 @(todo.IsCompleted ? "text-decoration-line-through text-muted" : "")">@todo.Title</h6>
                            <small class="text-muted">Oluşturulma: @todo.CreatedAt.ToString("dd.MM.yyyy")</small>
                        </div>
                        @if(todo.IsCompleted) { <span class="badge bg-success">Tamamlandı</span> }
                        else { <span class="badge bg-warning text-dark">Devam Ediyor</span> }
                    </a>
                }
            </div>
        }
        else
        {
            <div class="alert alert-secondary">Bu kullanıcının henüz bir görevi bulunmuyor.</div>
        }
    </div>
</div>