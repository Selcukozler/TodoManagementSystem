@model TodoManagementSystem.Models.ApplicationUser
@{ ViewData["Title"] = "Profilim"; }

<div class="row mt-4">
    <!-- Sol Taraf: Fotoğraf İşlemleri -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm text-center">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                {
                    <img src="@Model.ProfilePicturePath" class="rounded-circle img-thumbnail mb-3" style="width: 150px; height: 150px; object-fit: cover;" />
                    <form asp-action="RemoveProfilePicture" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Fotoğrafı Kaldır</button>
                    </form>
                }
                else
                {
                    <img src="https://cdn-icons-png.flaticon.com/512/149/149071.png" class="rounded-circle img-thumbnail mb-3" style="width: 150px; height: 150px; object-fit: cover;" />
                }
                
                <hr />
                <form asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data">
                    <input type="file" name="profilePicture" class="form-control form-control-sm mb-2" accept="image/*" required />
                    <button type="submit" class="btn btn-sm btn-success w-100">Yeni Fotoğraf Yükle</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Sağ Taraf: İsteğe Bağlı Bilgiler -->
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">Profil Bilgileri</div>
            <div class="card-body">
                <form asp-action="UpdateProfileInfo" method="post">
                    <div class="form-group mb-3">
                        <label class="fw-bold">E-posta</label>
                        <input type="text" class="form-control" value="@Model.Email" disabled />
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label class="fw-bold">Ad</label>
                            <input type="text" name="firstName" class="form-control" value="@Model.FirstName" placeholder="İsteğe bağlı..." />
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label class="fw-bold">Soyad</label>
                            <input type="text" name="lastName" class="form-control" value="@Model.LastName" placeholder="İsteğe bağlı..." />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label class="fw-bold">Hakkımda</label>
                        <textarea name="bio" class="form-control" rows="3" placeholder="Kendinden biraz bahset...">@Model.Bio</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Bilgileri Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>