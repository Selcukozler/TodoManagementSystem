@model List<TodoManagementSystem.Models.ApplicationUser>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "_AdminLayout";
}

<h1 class="h3 mb-4 text-gray-800">Kullanıcı Yönetimi</h1>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Kayıtlı Kullanıcılar</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>E-Posta</th>
                        <th>Ad Soyad</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Email</td>
                            <td>@(string.IsNullOrEmpty(user.FirstName) ? "-" : $"{user.FirstName} {user.LastName}")</td>
                            <td>
                                <!-- SweetAlert Sınıfı Eklenmiş Silme Formu -->
                                <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="delete-form" data-message="Bu kullanıcıyı ve tüm verilerini silmek istediğinize emin misiniz?">
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i> Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>