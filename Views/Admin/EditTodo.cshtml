@model TodoManagementSystem.Models.TodoItem

@{
    ViewData["Title"] = "Görevi Düzenle (Admin)";
}

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Görevi Düzenle (Yetkili İşlemi)</h4>
            </div>
            <div class="card-body">
                <form asp-action="EditTodo" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="alert alert-warning">
                        <strong>Bilgi:</strong> Şu anda başka bir kullanıcının görevini düzenliyorsunuz.
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Title" class="control-label fw-bold">Başlık</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Description" class="control-label fw-bold">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group form-check mb-4">
                        <label class="form-check-label fw-bold">
                            <input class="form-check-input" asp-for="IsCompleted" /> Görev Tamamlandı mı?
                        </label>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Paneline Dön</a>
                        <button type="submit" class="btn btn-danger">Değişiklikleri Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>