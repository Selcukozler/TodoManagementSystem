@model List<TodoManagementSystem.Models.ApplicationUser>
@{
    ViewData["Title"] = "Sistem Özeti";
    // Eski tasarımı ezip, KESİNLİKLE SB Admin 2'yi kullanmasını sağlıyoruz:
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; 

    // Controller'dan gelen tüm görevleri yakalıyoruz
    var allTodos = ViewBag.AllTodos as IEnumerable<TodoManagementSystem.Models.TodoItem>;
}

<!-- Sayfa Başlığı -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Sistem Özeti</h1>
    <a asp-action="AssignTodo" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50"></i> Yeni Görev Ata
    </a>
</div>

<!-- Üst İstatistik Kartları -->
<div class="row">
    <!-- Toplam Kullanıcı Kartı -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            Sistemdeki Kullanıcılar</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count()</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-users fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toplam Görev Kartı -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            Toplam Görev Sayısı</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@(allTodos?.Count() ?? 0)</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-tasks fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Kullanıcılar Tablosu -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Sistemdeki Tüm Kullanıcılar</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Profil</th>
                        <th>Kullanıcı (E-Posta)</th>
                        <th>Ad Soyad</th>
                        <th>Sahip Olduğu Görevler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var userTaskCount = allTodos?.Count(t => t.UserId == user.Id) ?? 0;
                        <tr>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(user.ProfilePicturePath))
                                {
                                    <img src="@user.ProfilePicturePath" alt="Avatar" class="rounded-circle" width="30" height="30" style="object-fit:cover;">
                                }
                                else
                                {
                                    <i class="fas fa-user-circle fa-2x text-gray-400"></i>
                                }
                            </td>
                            <td>@user.Email</td>
                            <td>@(string.IsNullOrEmpty(user.FirstName) ? "-" : $"{user.FirstName} {user.LastName}")</td>
                            <td>
                                <span class="badge badge-info p-2">@userTaskCount Görev</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>