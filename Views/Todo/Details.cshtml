@model TodoManagementSystem.Models.TodoItem
@using Microsoft.AspNetCore.Identity
@inject UserManager<TodoManagementSystem.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Görev Detayı ve Yorumlar";
    Layout = "_UserLayout";
    var currentUserId = UserManager.GetUserId(User);
}

<div class="row">
    <!-- Sol Kolon: Sadece Okunabilir Görev Detayları -->
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Görev Detayları</h5>
                <div>
                    @if (Model.UserId == currentUserId)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm me-1">
                            <i class="bx bx-edit-alt me-1"></i> Düzenle
                        </a>
                    }
                    <a href="javascript:history.back()" class="btn btn-secondary btn-sm">
                        <i class="bx bx-arrow-back me-1"></i> Geri Dön
                    </a>
                </div>
            </div>
            <div class="card-body">
                <dl class="row mb-0 mt-3">
                    <dt class="col-sm-4 mb-3">Başlık:</dt>
                    <dd class="col-sm-8 mb-3">@Model.Title</dd>

                    <dt class="col-sm-4 mb-3">Açıklama:</dt>
                    <dd class="col-sm-8 mb-3">@(string.IsNullOrEmpty(Model.Description) ? "Açıklama girilmemiş." : Model.Description)</dd>

                    <dt class="col-sm-4 mb-3">Oluşturulma:</dt>
                    <dd class="col-sm-8 mb-3">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                    <dt class="col-sm-4 mb-0">Durum:</dt>
                    <dd class="col-sm-8 mb-0">
                        @if (Model.IsCompleted)
                        {
                            <span class="badge bg-label-success">Tamamlandı</span>
                        }
                        else
                        {
                            <span class="badge bg-label-warning text-dark">Devam Ediyor</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Sağ Kolon: Yorumlar Alanı -->
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <h5 class="card-header">Yorumlar</h5>
            
            <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                @if (Model.Comments != null && Model.Comments.Any())
                {
                    foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAt))
                    {
                        <div class="d-flex align-items-start mb-3 border-bottom pb-3">
                            <!-- Tıklanabilir Dinamik Profil Fotoğrafı -->
                            <div class="avatar me-3 mt-1">
                                <a asp-controller="Account" asp-action="UserProfile" asp-route-id="@comment.UserId">
                                    @if (comment.User != null && !string.IsNullOrEmpty(comment.User.ProfilePicturePath))
                                    {
                                        <img src="@comment.User.ProfilePicturePath" alt="Avatar" class="rounded-circle" style="width:40px; height:40px; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <img src="~/sneat/assets/img/avatars/1.png" alt="Avatar" class="rounded-circle" style="width:40px; height:40px; object-fit:cover;" />
                                    }
                                </a>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-1">
                                    <!-- Tıklanabilir İsim -->
                                    @if(comment.User != null)
                                    {
                                        <a asp-controller="Account" asp-action="UserProfile" asp-route-id="@comment.UserId" class="text-body text-decoration-underline fw-bold">
                                            @(string.IsNullOrEmpty(comment.User.FirstName) ? comment.User.UserName : $"{comment.User.FirstName} {comment.User.LastName}")
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="fw-bold">Bilinmeyen Kullanıcı</span>
                                    }
                                    <small class="text-muted float-end">@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                </h6>
                                <p class="mb-0 mt-1">@comment.Text</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">Bu göreve henüz yorum yapılmamış. İlk yorumu siz yapın!</p>
                }
            </div>
            
            <hr class="my-0">
            
            <div class="card-body">
                <!-- Yorum Ekleme Formu -->
                <form asp-action="AddComment" method="post">
                    <input type="hidden" name="todoId" value="@Model.Id" />
                    <div class="input-group">
                        <input type="text" name="text" class="form-control" placeholder="Bir yorum yazın..." required />
                        <button class="btn btn-primary" type="submit" title="Gönder">
                            <!-- Sneat'in Ok / Kağıt Uçak İkonu -->
                            <i class="bx bx-paper-plane fs-5"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>