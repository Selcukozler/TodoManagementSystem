@model TodoManagementSystem.Models.TodoItem

@{
    ViewData["Title"] = "Görev Detayı";
}

<div class="row mt-4">
    <!-- SOL TARAF: GÖREV BİLGİLERİ (SADECE OKUMA) -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-secondary text-white">
                <h4 class="mb-0">Görev Detayı</h4>
            </div>
            <div class="card-body">
                <h5 class="card-title text-primary">@Model.Title</h5>
                <p class="card-text mt-3">@Model.Description</p>
                
                <hr />
                
                <!-- GÖREV SAHİBİ (PP + TIKLANABİLİR İSİM) -->
                <p class="mb-2 d-flex align-items-center">
                    <strong class="me-2">Sahibi:</strong> 
                    <a asp-controller="Account" asp-action="UserProfile" asp-route-id="@Model.UserId" class="d-inline-flex align-items-center text-primary fw-bold text-decoration-none">
                        @if (!string.IsNullOrEmpty(Model.User?.ProfilePicturePath))
                        {
                            <img src="@Model.User.ProfilePicturePath" class="rounded-circle me-2 border shadow-sm" style="width: 26px; height: 26px; object-fit: cover;" alt="PP" />
                        }
                        else
                        {
                            <img src="https://cdn-icons-png.flaticon.com/512/149/149071.png" class="rounded-circle me-2 border shadow-sm" style="width: 26px; height: 26px; object-fit: cover;" alt="Varsayılan" />
                        }
                        @Model.User?.UserName
                    </a>
                </p>

                <p><strong>Oluşturulma:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                <p>
                    <strong>Durum:</strong> 
                    @if(Model.IsCompleted) { <span class="badge bg-success">Tamamlandı</span> }
                    else { <span class="badge bg-warning text-dark">Devam Ediyor</span> }
                </p>

                <div class="mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
                </div>
            </div>
        </div>
    </div>

    <!-- SAĞ TARAF: YORUMLAR -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">Yorumlar</h4>
            </div>
            <div class="card-body d-flex flex-column">
                
                <div class="flex-grow-1 mb-4" style="max-height: 350px; overflow-y: auto;">
                    @if (Model.Comments != null && Model.Comments.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var comment in Model.Comments)
                            {
                                <div class="border-bottom pb-2 mb-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        
                                        <!-- YORUM YAPAN KİŞİ (PP + TIKLANABİLİR İSİM) -->
                                        <a asp-controller="Account" asp-action="UserProfile" asp-route-id="@comment.UserId" class="d-flex align-items-center text-decoration-none">
                                            @if (!string.IsNullOrEmpty(comment.User?.ProfilePicturePath))
                                            {
                                                <img src="@comment.User.ProfilePicturePath" class="rounded-circle me-2 border" style="width: 28px; height: 28px; object-fit: cover;" alt="PP" />
                                            }
                                            else
                                            {
                                                <img src="https://cdn-icons-png.flaticon.com/512/149/149071.png" class="rounded-circle me-2 border" style="width: 28px; height: 28px; object-fit: cover;" alt="Varsayılan" />
                                            }
                                            <strong class="text-primary">@comment.User?.UserName</strong>
                                        </a>
                                        
                                        <small class="text-muted">@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                    </div>
                                    <p class="mb-0 mt-1 ms-4 text-dark">@comment.Text</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary" role="alert">
                            Bu göreve henüz yorum yapılmamış. İlk yorumu sen yap!
                        </div>
                    }
                </div>

                <!-- YENİ YORUM YAZMA FORMU -->
                <div class="mt-auto">
                    <form asp-controller="Todo" asp-action="AddComment" method="post">
                        <input type="hidden" name="todoId" value="@Model.Id" />
                        <div class="form-group mb-2">
                            <textarea name="text" class="form-control" rows="2" required placeholder="Yorumunuzu buraya yazın..."></textarea>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-info text-white">Yorum Gönder</button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>