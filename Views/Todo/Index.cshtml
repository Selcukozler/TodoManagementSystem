@{
    ViewData["Title"] = "Görev Panosu";
    Layout = "_UserLayout";
    
    // Controller'dan ViewBag ile gönderdiğin kendi görevlerini yakalıyoruz
    var myTodos = ViewBag.MyTodos as IEnumerable<TodoManagementSystem.Models.TodoItem>;
}

<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Görev Panosu</h5>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bx bx-plus me-1"></i> Yeni Görev Ekle
                </a>
            </div>
            
            <div class="card-body">
                @if (myTodos != null && myTodos.Any())
                {
                    <div class="table-responsive text-nowrap">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Açıklama / Başlık</th>
                                    <th>Oluşturulma Tarihi</th>
                                    <th>Durum</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody class="table-border-bottom-0">
                                @foreach (var item in myTodos)
                                {
                                    <tr>
                                        <td>
                                            <strong class="@(item.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                                                @item.Title
                                            </strong>
                                        </td>
                                        <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>
                                            @if (item.IsCompleted)
                                            {
                                                <span class="badge bg-label-success">Tamamlandı</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-label-warning text-dark">Devam Ediyor</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2">
                                                <i class="bx bx-edit-alt me-1"></i> Düzenle / Yorum Yap
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="bx bx-trash me-1"></i> Sil
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary mt-2 mb-0" role="alert">
                        Henüz hiç göreviniz bulunmuyor. Sağ üstten yeni görev ekleyebilirsiniz.
                    </div>
                }
            </div>
        </div>
    </div>
</div>