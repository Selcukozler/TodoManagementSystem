@model IEnumerable<TodoManagementSystem.Models.TodoItem>

@{
    ViewData["Title"] = "Görevlerim";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2>Görevlerim</h2>
    <a asp-action="Create" class="btn btn-success">Yeni Görev Ekle</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Başlık</th>
                    <th>Durum</th>
                    <th>Oluşturulma Tarihi</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Title</td>
                        <td>
                            @if (item.IsCompleted)
                            {
                                <span class="badge bg-success">Tamamlandı</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Devam Ediyor</span>
                            }
                        </td>
                        <td>@item.CreatedAt.ToShortDateString()</td>
                        
                        <td>
    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
</td>
<td>
                            
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger ms-1">Sil</a>
                        </td>
                        
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>