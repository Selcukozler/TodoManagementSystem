@model TodoManagementSystem.Models.TodoItem

@{
    ViewData["Title"] = "Görevi Düzenle";
}

<div class="row mt-4">
    <!-- SOL TARAF: GÖREV DÜZENLEME FORMU -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Görevi Düzenle</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <!-- Hangi görevi güncellediğimizi bilmesi için ID'yi gizli olarak gönderiyoruz -->
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="form-group mb-3">
                        <label asp-for="Title" class="control-label fw-bold">Başlık</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Description" class="control-label fw-bold">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group form-check mb-4">
                        <label class="form-check-label fw-bold">
                            <input class="form-check-input" asp-for="IsCompleted" /> Görev Tamamlandı 
                        </label>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
                        <button type="submit" class="btn btn-warning">Değişiklikleri Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SAĞ TARAF: YORUMLAR -->
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">Yorumlar</h4>
            </div>
            <div class="card-body d-flex flex-column">
                
                <!-- Yorum Listesi -->
                <div class="flex-grow-1 mb-4" style="max-height: 350px; overflow-y: auto;">
                    @if (Model.Comments != null && Model.Comments.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var comment in Model.Comments)
                            {
                                <li class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center">
        @if (!string.IsNullOrEmpty(comment.User?.ProfilePicturePath))
        {
            <img src="@comment.User.ProfilePicturePath" class="rounded-circle me-2" style="width: 28px; height: 28px; object-fit: cover;" alt="PP" />
        }
        else
        {
            <img src="https://cdn-icons-png.flaticon.com/512/149/149071.png" class="rounded-circle me-2" style="width: 28px; height: 28px; object-fit: cover;" alt="Varsayılan" />
        }
        <strong class="text-primary">@comment.User?.UserName</strong>
    </div>
    <small class="text-muted">@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
</div>
                                    <p class="mb-0 mt-1">@comment.Text</p>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="alert alert-secondary" role="alert">
                            Bu göreve henüz yorum yapılmamış. İlk yorumu sen yap!
                        </div>
                    }
                </div>

                <!-- Yeni Yorum Formu -->
                <div class="mt-auto">
                    <form asp-controller="Todo" asp-action="AddComment" method="post">
                        <input type="hidden" name="todoId" value="@Model.Id" />
                        
                        <div class="form-group mb-2">
                            <textarea name="text" class="form-control" rows="2" required placeholder="Yorumunuzu buraya yazın..."></textarea>
                        </div>
                        
                        <div class="d-grid">
                            <button type="submit" class="btn btn-info text-white">Yorum Gönder</button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>