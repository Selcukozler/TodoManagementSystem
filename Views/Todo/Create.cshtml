@model TodoManagementSystem.Models.TodoItem
@{
    ViewData["Title"] = "Yeni Görev Ekle";
    Layout = "_UserLayout";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Yeni Görev Oluştur</h5>
                <a asp-action="Index" class="btn btn-secondary btn-sm">
                    <i class="bx bx-arrow-back me-1"></i> Vazgeç
                </a>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Görev Başlığı</label>
                        <input asp-for="Title" class="form-control" placeholder="Örn: Raporları hazırla..." required />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Detaylı Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Görev ile ilgili ek notlar..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-save me-1"></i> Görevi Kaydet
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>