@model TodoManagementSystem.Models.TodoItem

@{
    ViewData["Title"] = "Yeni Görev Ekle";
}

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Yeni Görev Ekle</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="form-group mb-3">
                        <label asp-for="Title" class="control-label fw-bold">Başlık</label>
                        <input asp-for="Title" class="form-control" placeholder="Örn: Proje raporunu hazırla..." />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-4">
                        <label asp-for="Description" class="control-label fw-bold">Açıklama (İsteğe Bağlı)</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Detayları buraya yazabilirsiniz..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
                        <button type="submit" class="btn btn-success">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>