@using Microsoft.AspNetCore.Identity
@using TodoManagementSystem.Models
@inject Microsoft.AspNetCore.Identity.SignInManager<TodoManagementSystem.Models.ApplicationUser> SignInManager
@inject Microsoft.AspNetCore.Identity.UserManager<TodoManagementSystem.Models.ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TodoManagementSystem</title>
    <link rel="stylesheet" href="~/argon/css/core.css" /> <!-- Şablonun CSS dosyası -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TodoManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">TodoManagementSystem</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-toggle="target" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    
                    <!-- SOL MENÜ (Ana Linkler) -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        
                        <!-- SADECE GİRİŞ YAPANLARIN GÖRECEĞİ GÖREVLERİM BUTONU -->
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item ms-3">
                                <a class="nav-link text-dark" asp-controller="Todo" asp-action="Index">Görevlerim</a>
                            </li>
                        }

                        <!-- SADECE ADMİN ROLÜNE SAHİP KİŞİLERİN GÖRECEĞİ BUTON -->
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item ms-3">
                                <a class="nav-link text-dark " asp-controller="Admin" asp-action="Index"> Admin Paneli</a>
                            </li>
                        }
                    </ul>

                    <!-- SAĞ MENÜ (Giriş / Çıkış İşlemleri) -->
                    <ul class="navbar-nav ms-auto">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            // İŞTE BURAYA KULLANICIYI ÇEKEN KODU EKLEDİK
                            var currentUser = await UserManager.GetUserAsync(User);

                            <li class="nav-item d-flex align-items-center">
                                <a class="nav-link text-primary fw-bold me-3 d-flex align-items-center" asp-controller="Account" asp-action="Profile">
                                    
                                    <!-- PROFİL FOTOĞRAFI GÖSTERİMİ -->
                                    @if (!string.IsNullOrEmpty(currentUser?.ProfilePicturePath))
                                    {
                                        <img src="@currentUser.ProfilePicturePath" class="rounded-circle me-2 shadow-sm" style="width: 35px; height: 35px; object-fit: cover;" alt="PP" />
                                    }
                                    else
                                    {
                                        <img src="https://cdn-icons-png.flaticon.com/512/149/149071.png" class="rounded-circle me-2 shadow-sm" style="width: 35px; height: 35px; object-fit: cover;" alt="Varsayılan" />
                                    }
                                    Profil
                                </a>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Çıkış Yap</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            </li>
                        }
                    </ul>
                    
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TodoManagementSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/argon/js/core.js"></script>
</body>
</html>